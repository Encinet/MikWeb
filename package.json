{
  "name": "mikweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:messages && bun run scripts/prepare-cap-assets.ts && bun run --bun next dev",
    "build": "bun run prepare:messages && bun run scripts/prepare-cap-assets.ts && bun run --bun next build",
    "prepare:messages": "bun run scripts/prepare-error-messages.ts",
    "start": "bun run --bun next start",
    "check:wiki": "bun run scripts/wiki-check.ts",
    "check:i18n": "bun run scripts/i18n-check.ts",
    "check": "bun check --no-script -p tsconfig.check.json && bun run check:i18n && bun run check:wiki",
    "test": "bun test --isolate tests",
    "test:chat": "bun test tests/chat",
    "test:compat": "bun test tests/compatibility"
  },
  "dependencies": {
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@vercel/analytics": "^2.0.1",
    "cap-widget": "0.1.63",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lucide-react": "^1.77.0",
    "mcp-handler": "^2.4.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-infinite-scroll-component": "^7.2.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cap.js/wasm": "0.0.8",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "mdast-util-mdx-jsx": "^3.2.1",
    "pako": "2.1.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
