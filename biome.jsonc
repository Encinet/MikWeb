{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!bun.lock", "!package-lock.json", "!next-env.d.ts", "!tsconfig.tsbuildinfo"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "preset": "recommended"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportMissingDependenciesArray": true
          }
        }
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useExportType": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": "Webkit[A-Za-z]+|short_name|start_url|background_color|theme_color|form_factor|query-input|Accept|(.*)"
              }
            ]
          }
        },
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error",
        "noDeprecatedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "preserve",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/modules/**",
                      "@/site/**",
                      "**/app/**",
                      "**/modules/**",
                      "**/site/**"
                    ],
                    "message": "Keep dependencies directed toward shared; compose pages in app and site."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/site/**", "**/app/**", "**/site/**"],
                    "message": "Keep dependencies directed toward shared; compose pages in app and site."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/site/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "**/app/**"],
                    "message": "Keep dependencies directed toward shared; compose pages in app and site."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/*/model/**", "src/modules/*/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/site/**", "**/app/**", "**/site/**"],
                    "message": "Keep business and shared logic independent of route and site composition."
                  },
                  {
                    "group": ["**/ui/**", "**/server/**"],
                    "message": "State and browser utilities must not depend on UI components or server implementation. Put shared contracts in model/types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/site/*/model/**", "src/site/*/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "**/app/**"],
                    "message": "Keep site capabilities independent of route entry points."
                  },
                  {
                    "group": ["**/ui/**", "**/server/**"],
                    "message": "Site state and utilities must not depend on UI components or server implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/hooks/**", "src/shared/lib/**", "src/shared/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/modules/**",
                      "@/site/**",
                      "**/app/**",
                      "**/modules/**",
                      "**/site/**"
                    ],
                    "message": "Shared utilities must be independent of application and business code."
                  },
                  {
                    "group": ["**/ui/**", "**/server/**"],
                    "message": "Shared hooks, utilities and contracts must not depend on components or server implementation."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
